rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function validPost() {
      return request.resource.data.keys().hasOnly(['title', 'content', 'timestamp'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.timestamp == request.time;
    }

    function validComment() {
      return request.resource.data.keys().hasOnly(['name', 'msg', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.msg is string
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 500
        && request.resource.data.timestamp == request.time;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn() && validPost();
      allow delete: if isSignedIn();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if validComment();
      allow update, delete: if isSignedIn();
    }

    // Configure this document once in the Firebase console. Clients cannot change ownership.
    match /site_config/access {
      allow read: if true;
      allow write: if false;
    }

    function isWikiOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/site_config/access)
        && get(/databases/$(database)/documents/site_config/access).data.ownerUid == request.auth.uid;
    }

    match /wcu/active {
      allow read: if isWikiOwner();
      allow create, update: if isWikiOwner()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'databaseJson', 'revision', 'updatedAt', 'updatedBy'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.databaseJson is string
        && request.resource.data.databaseJson.size() <= 850000
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/wcu/active) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/wcu/active) && request.resource.data.revision == resource.data.revision + 1))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
